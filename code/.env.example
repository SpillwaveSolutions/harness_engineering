# Copy to .env and fill in only the keys you intend to call.
# Listings import and the offline demos run with every value left blank.
# Live calls also need HARNESS_LIVE_API=1.

HARNESS_LIVE_API=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
